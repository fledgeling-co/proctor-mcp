{
 "schema": "tui-design/spec/1",
 "title": "proctor - run-empty",
 "size": {
  "cols": 80,
  "rows": 24
 },
 "theme": "dark",
 "roles": {
  "surface": {
   "bg": "#14161B"
  },
  "surface-lift": {
   "bg": "#1B1E25"
  },
  "text": {
   "fg": "#E9EAED"
  },
  "text-strong": {
   "fg": "#FFFFFF",
   "bold": true
  },
  "text-dim": {
   "fg": "#9AA1AF"
  },
  "border": {
   "fg": "#6E7686"
  },
  "border-focus": {
   "fg": "#D2A059"
  },
  "accent": {
   "fg": "#D2A059"
  },
  "ok": {
   "fg": "#74C79B"
  },
  "warn": {
   "fg": "#E3B76A"
  },
  "danger": {
   "fg": "#F1897F"
  },
  "selected": {
   "reverse": true
  }
 },
 "alt_screen": true,
 "root": {
  "dir": "col",
  "children": [
   {
    "h": 1,
    "keybar": {
     "style": "bracket",
     "items": [
      [
       "1",
       "RUN"
      ],
      [
       "2",
       "queue"
      ],
      [
       "3",
       "readiness"
      ],
      [
       "4",
       "history"
      ],
      [
       "5",
       "switches"
      ]
     ]
    }
   },
   {
    "flex": 1,
    "dir": "col",
    "children": [
     {
      "flex": 1,
      "panel": {
       "title": "RUN",
       "border": "round",
       "shelf_right": "host \u00b7 native",
       "child": {
        "text": {
         "align": "centre",
         "role": "text-dim",
         "lines": [
          "",
          "Nothing running.",
          "",
          "Proctor is listening on the agent socket. A run",
          "appears here the moment a model calls a tool.",
          "",
          "Press <3> for readiness, <?> for keys."
         ]
        }
       }
      }
     }
    ]
   },
   {
    "h": 1,
    "keybar": {
     "style": "bracket",
     "items": [
      [
       "p",
       "pause"
      ],
      [
       "s",
       "stop"
      ],
      [
       "d",
       "drop waiting"
      ],
      [
       "?",
       "help"
      ],
      [
       "q",
       "quit"
      ]
     ]
    }
   }
  ]
 }
}