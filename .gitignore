# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/
*.xcworkspace/
DerivedData/
*.xcuserstate
xcuserdata/

# Build products
# Proctor.icns is generated from source art by the icon pipeline; the .iconset
# and the compiled .icns are both build products. Commit the source art, not these.
*.icns
*.iconset/
Proctor.app/
*.zip

# Local agent state — flows, sockets, logs. Machine-specific, never shared.
flows/
logs/
*.log
*.sock

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# ship-fleet worktrees (never committed)
.worktrees/

# Private status pages (whats-left). Written for one reader; names live state,
# credentials and decisions. Never pushed to a remote, public or otherwise.
docs/status/

# Icon commission: keep the editable master (svg + build script + 1024 render),
# drop the heavy iteration provenance so the public repo stays lean.
design/icon/runs/
design/icon/audit-renders/
design/icon/audit.html
design/icon/*-raster-*.png
design/icon/*-arrow-*.svg
